# API auth for clients calling this service
TRIVIA_SERVICE_API_KEY=change-me

# LLM providers (enable any subset; pipeline uses whichever have keys configured).
# Fact-checking uses each provider's own native web search grounding, so no
# separate search API key is needed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# SQLite file path (inside the container; mounted via ./data in docker-compose.yml)
DATABASE_URL=sqlite+aiosqlite:////app/data/trivia.db

# Novelty check similarity threshold (0-1, higher = stricter dedup)
NOVELTY_SIMILARITY_THRESHOLD=0.87
